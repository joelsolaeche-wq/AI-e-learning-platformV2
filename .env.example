# Supabase — get from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Your app's base URL — used for email redirect links (e.g. http://localhost:3000 or https://yourapp.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Phase 4 (Mux video) — not needed until Phase 4
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=

# AI Tutor — Anthropic API key (get from console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Optional: GitHub PAT for the lab evaluator. Without it, GitHub allows ~60
# unauthenticated requests/hour from this server's IP — enough for demo, but
# fragile under load. With a PAT (no scopes needed for public-only reads),
# the limit becomes ~5000/hour. Generate at github.com/settings/tokens.
# GITHUB_TOKEN=
